POSTGRES_DB=pompom
POSTGRES_USER=pompom
POSTGRES_PASSWORD=pompom_local

# OpenArt CLI (leave defaults for mock development)
OPENART_ENABLED=false
OPENART_MOCK_ENABLED=true
# Optional: use OPENART_TOKEN instead of ~/.openart/cli-credentials.json
OPENART_TOKEN=
OPENART_CREDENTIALS_DIR=
OPENART_CLI_TIMEOUT=300
OPENART_MAX_POLLS=180
OPENART_MONTHLY_BUDGET=1000
OPENART_WARNING_THRESHOLD=0.2
POMPOM_UPSCALE_ENABLED=true
POMPOM_UPSCALE_TARGET_RESOLUTION=1920x1080
POMPOM_UPSCALE_TIMEOUT=900

{
  "type": "json_schema",
  "json_schema": {
    "name": "semantic_opening_seed_v1",
    "strict": false,
    "schema": {
      "$defs": {
        "OpeningSeed": {
          "additionalProperties": false,
          "properties": {
            "seedId": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$",
              "title": "Seedid",
              "type": "string"
            },
            "protagonistSuggestion": {
              "maxLength": 100,
              "minLength": 1,
              "title": "Protagonistsuggestion",
              "type": "string"
            },
            "everydayGoal": {
              "maxLength": 300,
              "minLength": 3,
              "title": "Everydaygoal",
              "type": "string"
            },
            "primaryObject": {
              "maxLength": 100,
              "minLength": 2,
              "title": "Primaryobject",
              "type": "string"
            },
            "normalExpectation": {
              "maxLength": 600,
              "minLength": 8,
              "title": "Normalexpectation",
              "type": "string"
            },
            "impossibleRule": {
              "maxLength": 1200,
              "minLength": 12,
              "title": "Impossiblerule",
              "type": "string"
            },
            "visibleTrigger": {
              "maxLength": 300,
              "minLength": 3,
              "title": "Visibletrigger",
              "type": "string"
            },
            "whyThisObject": {
              "maxLength": 600,
              "minLength": 8,
              "title": "Whythisobject",
              "type": "string"
            },
            "goalRuleRelationship": {
              "maxLength": 600,
              "minLength": 8,
              "title": "Goalrulerelationship",
              "type": "string"
            },
            "frameZeroDescription": {
              "maxLength": 1800,
              "minLength": 15,
              "title": "Framezerodescription",
              "type": "string"
            },
            "openingPhysicalState": {
              "maxLength": 1800,
              "minLength": 3,
              "title": "Openingphysicalstate",
              "type": "string"
            },
            "openingGoalEvidence": {
              "maxLength": 1800,
              "minLength": 3,
              "title": "Openinggoalevidence",
              "type": "string"
            },
            "openingProblemEvidence": {
              "maxLength": 1800,
              "minLength": 3,
              "title": "Openingproblemevidence",
              "type": "string"
            },
            "environment": {
              "maxLength": 300,
              "minLength": 3,
              "title": "Environment",
              "type": "string"
            },
            "dialogueNeed": {
              "enum": [
                "NONE",
                "OPTIONAL",
                "REQUIRED"
              ],
              "title": "Dialogueneed",
              "type": "string"
            }
          },
          "required": [
            "seedId",
            "protagonistSuggestion",
            "everydayGoal",
            "primaryObject",
            "normalExpectation",
            "impossibleRule",
            "visibleTrigger",
            "whyThisObject",
            "goalRuleRelationship",
            "frameZeroDescription",
            "openingPhysicalState",
            "openingGoalEvidence",
            "openingProblemEvidence",
            "environment",
            "dialogueNeed"
          ],
          "title": "OpeningSeed",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "seeds": {
          "items": {
            "$ref": "#/$defs/OpeningSeed"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Seeds",
          "type": "array"
        }
      },
      "required": [
        "seeds"
      ],
      "title": "SeedEnvelope",
      "type": "object"
    }
  }
}
{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ideas"
  ],
  "properties": {
    "ideas": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/SemanticIdea"
      }
    }
  },
  "$defs": {
    "SemanticIdea": {
      "additionalProperties": false,
      "properties": {
        "ideaId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$",
          "title": "Ideaid",
          "type": "string"
        },
        "title": {
          "maxLength": 160,
          "minLength": 3,
          "title": "Title",
          "type": "string"
        },
        "protagonistSuggestion": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Protagonistsuggestion",
          "type": "string"
        },
        "everydayGoal": {
          "maxLength": 300,
          "minLength": 3,
          "title": "Everydaygoal",
          "type": "string"
        },
        "primaryObject": {
          "maxLength": 100,
          "minLength": 2,
          "title": "Primaryobject",
          "type": "string"
        },
        "normalExpectation": {
          "maxLength": 600,
          "minLength": 8,
          "title": "Normalexpectation",
          "type": "string"
        },
        "impossibleRule": {
          "maxLength": 1200,
          "minLength": 12,
          "title": "Impossiblerule",
          "type": "string"
        },
        "visibleTrigger": {
          "maxLength": 300,
          "minLength": 3,
          "title": "Visibletrigger",
          "type": "string"
        },
        "whyThisObject": {
          "maxLength": 600,
          "minLength": 8,
          "title": "Whythisobject",
          "type": "string"
        },
        "goalRuleRelationship": {
          "maxLength": 600,
          "minLength": 8,
          "title": "Goalrulerelationship",
          "type": "string"
        },
        "frameZeroDescription": {
          "maxLength": 1800,
          "minLength": 15,
          "title": "Framezerodescription",
          "type": "string"
        },
        "beats": {
          "items": {
            "$ref": "#/$defs/SemanticBeat"
          },
          "maxItems": 5,
          "minItems": 4,
          "title": "Beats",
          "type": "array"
        },
        "finalPayoff": {
          "maxLength": 1200,
          "minLength": 8,
          "title": "Finalpayoff",
          "type": "string"
        },
        "suggestedPayoffFamily": {
          "maxLength": 100,
          "minLength": 2,
          "title": "Suggestedpayofffamily",
          "type": "string"
        },
        "loopPotential": {
          "maxLength": 400,
          "minLength": 2,
          "title": "Looppotential",
          "type": "string"
        },
        "environment": {
          "maxLength": 300,
          "minLength": 3,
          "title": "Environment",
          "type": "string"
        },
        "dialogueNeed": {
          "default": "NONE",
          "enum": [
            "NONE",
            "OPTIONAL",
            "REQUIRED"
          ],
          "title": "Dialogueneed",
          "type": "string"
        },
        "providerRationale": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Providerrationale",
          "type": "string"
        },
        "durationSeconds": {
          "default": 15,
          "maximum": 20,
          "minimum": 10,
          "title": "Durationseconds",
          "type": "number"
        }
      },
      "required": [
        "ideaId",
        "title",
        "protagonistSuggestion",
        "everydayGoal",
        "primaryObject",
        "normalExpectation",
        "impossibleRule",
        "visibleTrigger",
        "whyThisObject",
        "goalRuleRelationship",
        "frameZeroDescription",
        "beats",
        "finalPayoff",
        "suggestedPayoffFamily",
        "loopPotential",
        "environment",
        "providerRationale"
      ],
      "title": "SemanticIdea",
      "type": "object"
    },
    "SemanticBeat": {
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "maxLength": 300,
          "minLength": 3,
          "title": "Strategy",
          "type": "string"
        },
        "visibleConsequence": {
          "maxLength": 1200,
          "minLength": 8,
          "title": "Visibleconsequence",
          "type": "string"
        },
        "newInformation": {
          "maxLength": 600,
          "minLength": 5,
          "title": "Newinformation",
          "type": "string"
        }
      },
      "required": [
        "strategy",
        "visibleConsequence",
        "newInformation"
      ],
      "title": "SemanticBeat",
      "type": "object"
    }
  }
}

      "documentSha256": "ba352d486c4252c5c6fefe585ad976c0b6f73c299f7554863848bdd842a99b3d",
      "startOffset": 767,
      "endOffset": 815,
      "exactOriginalText": " Pip is relieved, but the cabinet remains messy."
    },

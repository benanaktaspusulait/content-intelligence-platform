  "triggers": {
    "WEIGHT_APPLIED": {
      "rule": "body weight is placed on it",
      "visible": true,
      "responseStrategies": [
        "pushes down through one palm for balance",
        "clamps the object between broad knees"
      ]
    },
    "PRESSURE": {
      "rule": "pressure is applied to it",
      "visible": true,
      "responseStrategies": [
        "pushes using both hands",
        "squeezes between broad forearms"
      ]
    },
    "LIFT": {
      "rule": "it is lifted",
      "visible": true,
      "responseStrategies": [
        "lifts using both hands",
        "grabs from underneath"
      ]
    },
    "STROKE": {
      "rule": "a stroke is completed",
      "visible": true,
      "responseStrategies": [
        "holds the far end of the object",
        "grabs close to the working edge"
      ]
    },
    "PULL": {
      "rule": "it is pulled",
      "visible": true,
      "responseStrategies": [
        "pulls with both hands",
        "clamps the sides with broad knees"
      ]
    },
    "RELEASE": {
      "rule": "it is released",
      "visible": true,
      "responseStrategies": [
        "holds the object by its edge",
        "wedges the body into the remaining clear space"
      ]
    }
  },
  "escalations": {
    "LINEAR_MAGNITUDE": {
      "strategies": [
        "uses one broad movement",
        "uses both hands with a wider movement",
        "uses a full-body movement"
      ],
      "stages": [
        1,
        2,
        3
      ]
    },
    "STRATEGY_RESPONSE": {
      "strategies": [
        "works from the front",
        "changes to a side approach",
        "changes to an underneath approach"
      ],
      "stages": [
        1,
        2,
        3
      ]
    },
    "SPACE_COMPRESSION": {
      "strategies": [
        "works at the center of the available space",
        "moves sideways into the remaining gap",
        "works from the last clear patch"
      ],
      "stages": [
        1,
        2,
        3
      ]
    },
    "CONTROL_LOSS": {
      "strategies": [
        "guides the object with one hand",
        "braces with both hands",
        "braces with the whole body"
      ],
      "stages": [
        1,
        2,
        3
      ]
    },
    "FALSE_PROGRESS": {
      "strategies": [
        "guides the object halfway to the goal",
        "guides it nearly to the goal",
        "holds it at the goal boundary"
      ],
      "stages": [
        1,
        2,
        3
      ]
    },
    "ACCUMULATION": {
      "strategies": [
        "uses one hand",
        "adds the second hand",
        "tries to free both hands with a broad body movement"
      ],
      "stages": [
        1,
        2,
        3
      ]
    },
    "STATE_CHAIN": {
      "strategies": [
        "works at the starting position",
        "moves to the middle position",
        "works at the goal position"
      ],
      "stages": [
        1,
        2,
        3
      ]
    }
  },

# Meta credentials (copy this file to .env and replace placeholders)
META_APP_ID=your_meta_app_id
META_BUSINESS_ID=your_meta_business_id
META_APP_SECRET=your_meta_app_secret
META_USER_ACCESS_TOKEN=your_meta_user_access_token
META_ACCESS_TOKEN=your_meta_user_access_token
META_PAGE_ID=your_facebook_page_id
META_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
META_INSTAGRAM_ACCOUNT_ID=your_instagram_professional_account_id
META_INSTAGRAM_ACCESS_TOKEN=your_instagram_insights_access_token

INSTAGRAM_APP_ID=1750692642803348
INSTAGRAM_APP_SECRET=b2d29865d03eb99dc002a85800592555


# Meta feature flags
META_ENABLE_FACEBOOK=true
META_ENABLE_INSTAGRAM=true
META_DRY_RUN=true
META_STORAGE_BACKEND=local

# TikTok (optional)
TIKTOK_ENABLE=false
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_PUBLISH_DB=data/tiktok_publish_log.db
TIKTOK_DRY_RUN=true

# YouTube (optional)
YOUTUBE_ENABLE=false
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token
YOUTUBE_ACCESS_TOKEN=your_youtube_access_token
YOUTUBE_PUBLISH_DB=data/youtube_publish_log.db
YOUTUBE_DRY_RUN=true
YOUTUBE_PRIVACY=private
YOUTUBE_MADE_FOR_KIDS=true
